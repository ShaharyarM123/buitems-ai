<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BUITEMS AI - Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">
  <div class="bg-white p-8 rounded-xl border border-gray-200 text-center max-w-sm">
    <h1 class="text-xl font-bold mb-2">Welcome to BUITEMS AI Dashboard</h1>
    <p class="text-sm text-gray-500 mb-6">Backend Authentication Succeeded!</p>
    
    <!-- Updated Logout Button -->
    <button 
      onclick="handleLogout()" 
      class="inline-block px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg text-sm transition-colors cursor-pointer"
    >
      Logout
    </button>
  </div>

  <!-- History Replacement Script -->
  <script>
    function handleLogout() {
      // Replaces current history entry to prevent backward navigation after logout
      window.location.replace('/logout');
    }
  </script>
</body>
</html>